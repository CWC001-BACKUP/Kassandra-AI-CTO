# Sibyl Memory (local-first — https://sibyllabs.org/ → Sibyl Memory Plugin)
# One-time setup in your terminal (not in this file):
#   pip install 'sibyl-memory-cli[mcp]'
#   sibyl init    # browser sign-in → writes SIBYL_CREDENTIALS below
# The FastAPI server uses the Python SDK directly (no sibyl setup needed).
SIBYL_DATA_DIR=./data/sibyl
SIBYL_CREDENTIALS=~/.sibyl-memory/credentials.json
