# Server
DEBUG=false
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# JWT / sessions
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=15

# Frontend
FRONTEND_URL=http://localhost:5173

# Email (Brevo — authenticate your domain in Brevo → Domains)
BREVO=your-brevo-api-key
FROM_NAME=Kassandra
FROM_EMAIL=noreply@yourdomain.com
REPLY_TO_EMAIL=support@yourdomain.com

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
GITHUB_WEBHOOK_SECRET=
WEBHOOK_BASE_URL=

# LLM Provider
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Sibyl Memory (local-first — https://sibyllabs.org/ → Sibyl Memory Plugin)
SIBYL_DATA_DIR=./data/sibyl
SIBYL_CREDENTIALS=~/.sibyl-memory/credentials.json
# SIBYL_TENANT_ID=
